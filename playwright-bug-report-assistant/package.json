{
  "name": "playwright-bug-report-assistant",
  "version": "1.0.0",
  "description": "Framework-independent automated failure analysis with a Playwright adapter",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "failure-analysis": "dist/cli.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./reporter": { "types": "./dist/bug-report-reporter.d.ts", "default": "./dist/bug-report-reporter.js" },
    "./playwright": { "types": "./dist/fixtures.d.ts", "default": "./dist/fixtures.js" }
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "test": "playwright test",
    "test:list": "playwright test --list",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "pack:check": "npm run build && npm pack --dry-run",
    "test:unit": "playwright test tests/unit.spec.ts",
    "analyze": "tsx src/cli.ts"
  },
  "license": "MIT",
  "engines": { "node": ">=20" },
  "repository": { "type": "git", "url": "git+https://github.com/Bmajor1997/python_projects.git", "directory": "playwright-bug-report-assistant" },
  "keywords": ["playwright", "testing", "failure-analysis", "openai", "developer-tools"],
  "peerDependencies": { "@playwright/test": ">=1.50.0" },
  "dependencies": { "openai": "^5.19.1" },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
